rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Participant records for Unicentro Maracay Halloween Game
    match /players/{playerId} {
      // Anyone can create and read their player profile, and update their unlocked stores/redemption status
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id', 'playerName', 'parentName', 'gender', 'createdAt']);
      allow update: if true;
      allow delete: if false;
    }

    // Health check collection for connection validation
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
